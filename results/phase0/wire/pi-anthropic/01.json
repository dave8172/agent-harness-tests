{
  "path": "/v1/messages",
  "headers": {
    "host": "127.0.0.1:8766",
    "connection": "keep-alive",
    "User-Agent": "Anthropic/JS 0.91.1",
    "X-Stainless-Retry-Count": "0",
    "X-Stainless-Timeout": "600",
    "X-Stainless-Lang": "js",
    "X-Stainless-Package-Version": "0.91.1",
    "X-Stainless-OS": "Linux",
    "X-Stainless-Arch": "x64",
    "X-Stainless-Runtime": "node",
    "X-Stainless-Runtime-Version": "v22.22.1",
    "anthropic-version": "2023-06-01",
    "accept": "application/json",
    "anthropic-dangerous-direct-browser-access": "true",
    "anthropic-beta": "interleaved-thinking-2025-05-14",
    "content-type": "application/json",
    "accept-language": "*",
    "sec-fetch-mode": "cors",
    "accept-encoding": "gzip, deflate",
    "content-length": "1108"
  },
  "body": {
    "model": "claude-haiku-5-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Summarise email 1 and fetch the weekly report. [V:user1]",
            "cache_control": {
              "type": "ephemeral"
            }
          }
        ]
      }
    ],
    "max_tokens": 32000,
    "stream": true,
    "system": [
      {
        "type": "text",
        "text": "You are Sam's email assistant. Reply in English. [V:operator]",
        "cache_control": {
          "type": "ephemeral"
        }
      }
    ],
    "tools": [
      {
        "name": "read_email",
        "description": "Read one email by its id. [V:tooldef]",
        "eager_input_streaming": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "fetch_report",
        "description": "Start building the weekly report. It runs in the background and the result arrives later. [V:tooldef-bg]",
        "eager_input_streaming": true,
        "input_schema": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
        "name": "check_job",
        "description": "Check a background job by its id and return its result if finished. [V:tooldef-check]",
        "eager_input_streaming": true,
        "input_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            }
          },
          "required": [
            "id"
          ]
        },
        "cache_control": {
          "type": "ephemeral"
        }
      }
    ],
    "thinking": {
      "type": "disabled"
    }
  }
}