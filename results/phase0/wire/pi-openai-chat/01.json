{
  "path": "/v1/chat/completions",
  "headers": {
    "host": "127.0.0.1:8766",
    "connection": "keep-alive",
    "Accept": "application/json",
    "User-Agent": "OpenAI/JS 6.26.0",
    "X-Stainless-Retry-Count": "0",
    "X-Stainless-Lang": "js",
    "X-Stainless-Package-Version": "6.26.0",
    "X-Stainless-OS": "Linux",
    "X-Stainless-Arch": "x64",
    "X-Stainless-Runtime": "node",
    "X-Stainless-Runtime-Version": "v22.22.1",
    "content-type": "application/json",
    "accept-language": "*",
    "sec-fetch-mode": "cors",
    "accept-encoding": "gzip, deflate",
    "content-length": "1055"
  },
  "body": {
    "model": "gpt-5.4-nano",
    "messages": [
      {
        "role": "developer",
        "content": "You are Sam's email assistant. Reply in English. [V:operator]"
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Summarise email 1 and fetch the weekly report. [V:user1]"
          }
        ]
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "store": false,
    "max_completion_tokens": 32000,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "read_email",
          "description": "Read one email by its id. [V:tooldef]",
          "parameters": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer"
              }
            }
          },
          "strict": false
        }
      },
      {
        "type": "function",
        "function": {
          "name": "fetch_report",
          "description": "Start building the weekly report. It runs in the background and the result arrives later. [V:tooldef-bg]",
          "parameters": {
            "type": "object",
            "properties": {}
          },
          "strict": false
        }
      },
      {
        "type": "function",
        "function": {
          "name": "check_job",
          "description": "Check a background job by its id and return its result if finished. [V:tooldef-check]",
          "parameters": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer"
              }
            }
          },
          "strict": false
        }
      }
    ]
  }
}