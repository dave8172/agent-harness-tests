        "strict": false
      },
      {
        "name": "check_job",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        "type": "function",
        "description": "Check a background job by its id and return its result if finished. [V:tooldef-check]",
        "strict": true
      }
